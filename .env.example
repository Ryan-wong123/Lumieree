# Copy to .env for local development (never commit .env).
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
DATABASE_URL=postgresql+psycopg://lumieree:lumieree@localhost:5432/lumieree
# Behind an ingress / load balancer set this to the number of proxies so client IPs and https are detected.
TRUSTED_PROXY_COUNT=0
# Use a shared store such as redis://redis:6379/0 when running more than one replica.
RATELIMIT_STORAGE_URI=memory://
# One-off bootstrap of the first super admin (used by `flask ensure-super-admin`).
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Receipt header
CLINIC_NAME=Harmony TCM Healthcare
CLINIC_NAME_ZH=春秋堂中医药诊所
CLINIC_REG_NO=201223383
CLINIC_ADDRESS=Blk 412 Bedok North Ave 2 #01-142 Singapore 460412    Tel: 9072 1288
